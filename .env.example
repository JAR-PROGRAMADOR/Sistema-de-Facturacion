# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- API ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Base de datos PostgreSQL (Neon, Supabase o local) ---
# DATABASE_ADMIN_URL: usuario DUEÑO del esquema. Solo para migraciones y pruebas.
#   En Neon usa la conexión DIRECTA (sin "-pooler" en el host).
DATABASE_ADMIN_URL=postgresql://USUARIO_DUENO:PASSWORD@TU-HOST-DE-NEON/NOMBRE_BD?sslmode=verify-full
# APP_DB_PASSWORD: contraseña (mínimo 16 caracteres, solo letras y números) que el script
#   de migraciones asigna al rol app_user.
APP_DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_ALEATORIA
# DATABASE_URL: EL MISMO HOST que DATABASE_ADMIN_URL, pero con el usuario app_user.
DATABASE_URL=postgresql://app_user:CAMBIAR_POR_UNA_CLAVE_LARGA_ALEATORIA@TU-HOST-DE-NEON/NOMBRE_BD?sslmode=verify-full

# --- Autenticación (FASE 3a) ---
JWT_ACCESS_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
LOGIN_RATE_LIMIT_MAX=10

# --- Recuperación de contraseña y 2FA (FASE 3b) ---
# URL pública del frontend: se usa para armar el enlace del correo de recuperación.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
# Sin estas dos, el enlace de recuperación solo se imprime en la consola del servidor
# (útil en desarrollo). Para enviar correos reales, crea una cuenta en https://resend.com,
# verifica un dominio o usa su dirección de pruebas, y pon aquí tu API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Nombre que aparece en la app de autenticación (Google Authenticator, etc.) junto al código.
TWO_FACTOR_ISSUER=Facturacion

# --- Docker (solo si usas PostgreSQL local) ---
POSTGRES_USER=facturacion
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=facturacion
